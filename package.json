{
  "name": "save-library",
  "version": "0.1.0",
  "private": true,
  "description": "Private, offline-first bookmark library PWA with an iOS Shortcut capture inbox.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
