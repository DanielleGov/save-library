{
  "name": "Save Library",
  "short_name": "Library",
  "description": "Private bookmark library for reels, videos and links.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f4f1",
